{
  "name": "autolabel-assistant",
  "productName": "自动标注小助手",
  "version": "0.1.1",
  "description": "本地图片管理、人工标注与 AI 辅助标注桌面工具",
  "author": "AutoLabel",
  "private": true,
  "main": "desktop/dist/main.cjs",
  "scripts": {
    "dev": "node scripts/desktop-dev.mjs",
    "start": "node scripts/desktop-start.mjs",
    "build:desktop": "node scripts/desktop-build.mjs",
    "build:renderer": "npm --prefix renderer run build",
    "build:engine": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/engine-build.ps1",
    "build": "npm run build:engine && npm run build:renderer && npm run build:desktop",
    "check:desktop": "tsc --noEmit -p desktop/tsconfig.json",
    "test:desktop": "node scripts/desktop-test.mjs",
    "test:updates": "node scripts/desktop-update-test.mjs",
    "smoke:desktop": "node scripts/desktop-smoke.mjs",
    "smoke:packaged": "node scripts/desktop-smoke.mjs --packaged",
    "check:window": "node scripts/desktop-smoke.mjs --packaged --window",
    "check:ui": "node scripts/desktop-smoke.mjs --packaged --ui",
    "check:update-ui": "node scripts/desktop-smoke.mjs --update-ui",
    "check:run-controls": "node scripts/desktop-smoke.mjs --run-controls",
    "check:media-ui": "node scripts/desktop-smoke.mjs --media",
    "check:reason-ui": "node scripts/desktop-smoke.mjs --reason",
    "check:annotate-ui": "node scripts/desktop-smoke.mjs --annotate",
    "check:unknown-retry-ui": "node scripts/desktop-smoke.mjs --unknown-retry",
    "check:frame-scope-ui": "node scripts/desktop-smoke.mjs --frame-scope",
    "check:project-identity-ui": "node scripts/desktop-smoke.mjs --project-identity",
    "check:directory-import-ui": "node scripts/desktop-smoke.mjs --directory-import",
    "check:onboarding-ui": "node scripts/desktop-smoke.mjs --onboarding-ui",
    "check:ai-preset-ui": "node scripts/desktop-smoke.mjs --ai-preset",
    "check:composer-ui": "node scripts/desktop-smoke.mjs --composer-ui",
    "check:connection-ui": "node scripts/desktop-smoke.mjs --connection-ui",
    "check:training-ui": "node scripts/desktop-smoke.mjs --training-ui",
    "check:installer-contract": "node scripts/installer-contract-check.mjs",
    "check:engine-jar": "node scripts/engine-jar-freshness.mjs",
    "check:packaged-jar": "node scripts/engine-jar-freshness.mjs --package",
    "check:agent": "tsc -p agent/tsconfig.json",
    "test:agent": "npm --prefix agent test",
    "prepare:runtime": "node scripts/desktop-runtime.mjs",
    "prepare:media-tools": "node scripts/desktop-media-tools.mjs",
    "pack:dir": "npm run build && npm run check:engine-jar && npm run prepare:runtime && npm run prepare:media-tools && electron-builder --win --x64 --dir --config build/electron-builder.cjs",
    "pack:win": "npm run build && npm run check:engine-jar && npm run prepare:runtime && npm run prepare:media-tools && electron-builder --win nsis --x64 --config build/electron-builder.cjs",
    "pack:milestone": "npm run build:renderer && npm run build:desktop && npm run prepare:media-tools && node scripts/desktop-pack-milestone.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3"
  },
  "dependencies": { "zod": "^4.0.0" }
}
